# Copia este archivo a .env.local y llena los valores. Nunca lo subas a git.

# Auth.js
AUTH_SECRET=                      # genera con: npx auth secret
ALLOWED_EMAIL_DOMAIN=uniminuto.edu.co

# Microsoft Entra ID (registro de la app en portal.azure.com)
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=               # vacío = "common" con filtro de dominio

# Base de datos (Supabase)
DATABASE_URL=                     # conexión con pooler
DIRECT_URL=                       # conexión directa para migraciones
DATABASE_URL_LECTURA=             # usuario de solo lectura para el MCP de Postgres

# Catálogo oficial (base de datos EXTRA, separada)
CATALOGO_DATABASE_URL=            # otra base / proyecto de Supabase
CATALOGO_API_URL=http://localhost:3000/api/catalogo/v1
CATALOGO_API_KEY=                 # llave de la app hoja de vida (se guarda su hash en cliente_api)
SOCRATA_APP_TOKEN=                # opcional: más cupo en datos.gov.co

# Storage (Supabase)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=soportes

# Harness
GITHUB_TOKEN=                     # para el MCP de GitHub
