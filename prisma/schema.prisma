// Esquema de datos — Hoja de Vida UNIMINUTO
// Cada modelo corresponde a una sección del Formato Único de Hoja de Vida
// (Leyes 190 de 1995, 489 y 443 de 1998). La sección 7 se calcula; no se guarda.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Catálogos (códigos del formato) ─────────────────────────────

enum EstadoHojaVida {
  BORRADOR
  COMPLETA
}

enum TipoDocumento {
  CC
  CE
  PAS
}

enum Genero {
  F
  M
  NB
}

enum Nacionalidad {
  COLOMBIANA
  EXTRANJERA
}

enum ClaseLibreta {
  PRIMERA
  SEGUNDA
}

/// Sección 2 — Educación superior
enum ModalidadSuperior {
  TC  // Técnica
  TL  // Tecnológica
  TE  // Tecnológica especializada
  UN  // Universitaria
  ES  // Especialización
  MG  // Maestría o magíster
  DOC // Doctorado o PhD
}

/// Sección 3 — Educación para el trabajo
enum ModalidadTrabajo {
  INF    // Educación informal
  TR_DES // Educación para el trabajo y el desarrollo humano
}

/// Sección 4 — Idiomas
enum NivelIdioma {
  R  // Regular
  B  // Bien
  MB // Muy bien
}

enum Sector {
  PUBLICO
  PRIVADO
}

/// Resultado de validar una entidad contra el catálogo oficial (spec 002)
enum EstadoVerificacion {
  PENDIENTE
  VERIFICADO              // existe en el catálogo; datos copiados de la versión vigente
  VERIFICADO_CON_SOPORTE  // no está en el catálogo; el estudiante subió el diploma
  NO_ENCONTRADO
  SIN_FUENTE              // la API del catálogo no respondió; se reintenta
}

enum TipoSoporte {
  FOTO
  DOCUMENTO_IDENTIDAD
  DIPLOMA
  CERTIFICADO_LABORAL
  CERTIFICADO_ESTUDIO
  LIBRETA_MILITAR
  OTRO
}

// ─── Usuario y hoja de vida ──────────────────────────────────────

model Usuario {
  id                String     @id @default(uuid())
  correo            String     @unique // siempre termina en @uniminuto.edu.co
  nombre            String
  tenantId          String     @map("tenant_id")
  ultimoIngreso     DateTime   @default(now()) @map("ultimo_ingreso")
  creadoEn          DateTime   @default(now()) @map("creado_en")
  hojaVida          HojaVida?
  auditoria         Auditoria[]

  @@map("usuario")
}

model Plantilla {
  id                 String     @id @default(uuid())
  nombre             String     @unique // p. ej. "UNIMINUTO 2026"
  logoUrl            String?    @map("logo_url")
  encabezado         String?
  seccionesVisibles  Int[]      @map("secciones_visibles") // 1..9
  camposAdicionales  Json?      @map("campos_adicionales") // definición de campos extra de UNIMINUTO
  activa             Boolean    @default(true)
  hojasVida          HojaVida[]

  @@map("plantilla")
}

model HojaVida {
  id                   String          @id @default(uuid())
  usuarioId            String          @unique @map("usuario_id")
  usuario              Usuario         @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  plantillaId          String?         @map("plantilla_id")
  plantilla            Plantilla?      @relation(fields: [plantillaId], references: [id])
  estado               EstadoHojaVida  @default(BORRADOR)
  entidadReceptora     String?         @map("entidad_receptora")
  camposAdicionales    Json?           @map("campos_adicionales") // valores de los campos extra (programa, sede, ID estudiantil…)
  habeasDataAceptado   Boolean         @default(false) @map("habeas_data_aceptado")
  habeasDataFecha      DateTime?       @map("habeas_data_fecha")
  habeasDataVersion    String?         @map("habeas_data_version")
  ultimoPaso           Int             @default(1) @map("ultimo_paso")
  creadoEn             DateTime        @default(now()) @map("creado_en")
  actualizadoEn        DateTime        @updatedAt @map("actualizado_en")

  datosPersonales      DatosPersonales?
  educacionBasica      EducacionBasica?
  educacionSuperior    EducacionSuperior[]
  educacionTrabajo     EducacionTrabajo[]
  idiomas              Idioma[]
  experienciaLaboral   ExperienciaLaboral[]
  experienciaDocente   ExperienciaDocente[]
  declaracion          Declaracion?
  soportes             DocumentoSoporte[]

  @@map("hoja_vida")
}

// ─── Sección 1: Datos personales ─────────────────────────────────

model DatosPersonales {
  id                    String         @id @default(uuid())
  hojaVidaId            String         @unique @map("hoja_vida_id")
  hojaVida              HojaVida       @relation(fields: [hojaVidaId], references: [id], onDelete: Cascade)
  primerApellido        String?        @map("primer_apellido")
  segundoApellido       String?        @map("segundo_apellido") // o de casada
  nombres               String?
  tipoDocumento         TipoDocumento? @map("tipo_documento")
  numeroDocumento       String?        @map("numero_documento") // cifrado en reposo
  genero                Genero?
  nacionalidad          Nacionalidad?
  paisNacionalidad      String?        @map("pais_nacionalidad")
  libretaClase          ClaseLibreta?  @map("libreta_clase")
  libretaNumero         String?        @map("libreta_numero") // cifrado en reposo
  libretaDistrito       String?        @map("libreta_distrito") // D.M.
  fechaNacimiento       DateTime?      @db.Date @map("fecha_nacimiento")
  nacimientoPais        String?        @map("nacimiento_pais")
  nacimientoDepto       String?        @map("nacimiento_depto")
  nacimientoMunicipio   String?        @map("nacimiento_municipio")
  direccion             String?        // dirección de correspondencia
  direccionPais         String?        @map("direccion_pais")
  direccionDepto        String?        @map("direccion_depto")
  direccionMunicipio    String?        @map("direccion_municipio")
  telefono              String?
  email                 String?
  version               Int            @default(1)
  actualizadoEn         DateTime       @updatedAt @map("actualizado_en")

  @@map("datos_personales")
}

// ─── Sección 2: Formación académica ──────────────────────────────

model EducacionBasica {
  id              String   @id @default(uuid())
  hojaVidaId      String   @unique @map("hoja_vida_id")
  hojaVida        HojaVida @relation(fields: [hojaVidaId], references: [id], onDelete: Cascade)
  // Colegio: referencia lógica al catálogo (otra base de datos, solo vía API)
  colegioCodigoDane String?            @map("colegio_codigo_dane")
  colegioVersionId  Int?               @map("colegio_version_id") // versión del catálogo al guardar
  colegioNombre     String?            @map("colegio_nombre") // copiado del catálogo, no del navegador
  colegioMunicipio  String?            @map("colegio_municipio")
  colegioSoporteId  String?            @map("colegio_soporte_id") // diploma si no está en el catálogo
  verificacion      EstadoVerificacion @default(PENDIENTE)
  verificadoEn      DateTime?          @map("verificado_en")
  ultimoGrado     Int?     @map("ultimo_grado") // 1 a 11
  tituloObtenido  String?  @map("titulo_obtenido")
  gradoMes        Int?     @map("grado_mes")
  gradoAnio       Int?     @map("grado_anio")
  version         Int      @default(1)
  actualizadoEn   DateTime @updatedAt @map("actualizado_en")

  @@map("educacion_basica")
}

model EducacionSuperior {
  id                   String            @id @default(uuid())
  hojaVidaId           String            @map("hoja_vida_id")
  hojaVida             HojaVida          @relation(fields: [hojaVidaId], references: [id], onDelete: Cascade)
  institucionCodigoSnies String?            @map("institucion_codigo_snies")
  institucionVersionId   Int?               @map("institucion_version_id")
  institucionNombre      String?            @map("institucion_nombre")
  verificacion           EstadoVerificacion @default(PENDIENTE)
  modalidad            ModalidadSuperior
  semestresAprobados   Int?              @map("semestres_aprobados")
  graduado             Boolean
  titulo               String            // nombre de los estudios o título obtenido
  terminacionMes       Int?              @map("terminacion_mes")
  terminacionAnio      Int?              @map("terminacion_anio")
  tarjetaProfesional   String?           @map("tarjeta_profesional")
  orden                Int               @default(0)
  version              Int               @default(1)
  actualizadoEn        DateTime          @updatedAt @map("actualizado_en")

  @@index([hojaVidaId])
  @@map("educacion_superior")
}

// ─── Sección 3: Educación para el trabajo y el desarrollo humano ─

model EducacionTrabajo {
  id              String           @id @default(uuid())
  hojaVidaId      String           @map("hoja_vida_id")
  hojaVida        HojaVida         @relation(fields: [hojaVidaId], references: [id], onDelete: Cascade)
  institucion     String
  modalidad       ModalidadTrabajo
  totalHoras      Int?             @map("total_horas")
  graduado        Boolean
  titulo          String
  terminacionMes  Int?             @map("terminacion_mes")
  terminacionAnio Int?             @map("terminacion_anio")
  orden           Int              @default(0)
  version         Int              @default(1)
  actualizadoEn   DateTime         @updatedAt @map("actualizado_en")

  @@index([hojaVidaId])
  @@map("educacion_trabajo")
}

// ─── Sección 4: Idiomas ──────────────────────────────────────────

model Idioma {
  id            String      @id @default(uuid())
  hojaVidaId    String      @map("hoja_vida_id")
  hojaVida      HojaVida    @relation(fields: [hojaVidaId], references: [id], onDelete: Cascade)
  idioma        String
  habla         NivelIdioma
  lee           NivelIdioma
  escribe       NivelIdioma
  version       Int         @default(1)
  actualizadoEn DateTime    @updatedAt @map("actualizado_en")

  @@unique([hojaVidaId, idioma])
  @@map("idioma")
}

// ─── Sección 5: Experiencia laboral ──────────────────────────────

model ExperienciaLaboral {
  id              String    @id @default(uuid())
  hojaVidaId      String    @map("hoja_vida_id")
  hojaVida        HojaVida  @relation(fields: [hojaVidaId], references: [id], onDelete: Cascade)
  empresa         String
  sector          Sector
  esIndependiente Boolean   @default(false) @map("es_independiente") // para la sección 7
  pais            String?
  departamento    String?
  municipio       String?
  correoEntidad   String?   @map("correo_entidad")
  telefonos       String?
  fechaIngreso    DateTime  @db.Date @map("fecha_ingreso")
  fechaRetiro     DateTime? @db.Date @map("fecha_retiro") // null = empleo vigente
  cargo           String
  dependencia     String?
  direccion       String?
  version         Int       @default(1)
  actualizadoEn   DateTime  @updatedAt @map("actualizado_en")

  @@index([hojaVidaId])
  @@map("experiencia_laboral")
}

// ─── Sección 6: Experiencia laboral docente ──────────────────────

model ExperienciaDocente {
  id                String    @id @default(uuid())
  hojaVidaId        String    @map("hoja_vida_id")
  hojaVida          HojaVida  @relation(fields: [hojaVidaId], references: [id], onDelete: Cascade)
  institucion       String
  sector            Sector
  pais              String?
  departamento      String?
  municipio         String?
  correo            String?
  telefonos         String?
  fechaIngreso      DateTime  @db.Date @map("fecha_ingreso")
  fechaRetiro       DateTime? @db.Date @map("fecha_retiro")
  areaConocimiento  String?   @map("area_conocimiento")
  nivelEducativo    String?   @map("nivel_educativo")
  direccion         String?
  version           Int       @default(1)
  actualizadoEn     DateTime  @updatedAt @map("actualizado_en")

  @@index([hojaVidaId])
  @@map("experiencia_docente")
}

// ─── Sección 8: Declaración y firma ──────────────────────────────

model Declaracion {
  id                     String    @id @default(uuid())
  hojaVidaId             String    @unique @map("hoja_vida_id")
  hojaVida               HojaVida  @relation(fields: [hojaVidaId], references: [id], onDelete: Cascade)
  dentroDeInhabilidad    Boolean?  @map("dentro_de_inhabilidad") // casilla SI / NO
  ciudadDiligenciamiento String?   @map("ciudad_diligenciamiento")
  fechaDiligenciamiento  DateTime? @db.Date @map("fecha_diligenciamiento")
  firmaUrl               String?   @map("firma_url") // imagen opcional en storage
  version                Int       @default(1)
  actualizadoEn          DateTime  @updatedAt @map("actualizado_en")

  @@map("declaracion")
}

// ─── Soportes y auditoría ────────────────────────────────────────

model DocumentoSoporte {
  id          String      @id @default(uuid())
  hojaVidaId  String      @map("hoja_vida_id")
  hojaVida    HojaVida    @relation(fields: [hojaVidaId], references: [id], onDelete: Cascade)
  tipo        TipoSoporte
  nombre      String
  ruta        String      // ruta en el bucket privado
  tamanoBytes Int         @map("tamano_bytes")
  mimeType    String      @map("mime_type")
  subidoEn    DateTime    @default(now()) @map("subido_en")

  @@index([hojaVidaId])
  @@map("documento_soporte")
}

model Auditoria {
  id         String   @id @default(uuid())
  usuarioId  String   @map("usuario_id")
  usuario    Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  accion     String   // CREAR | ACTUALIZAR | ELIMINAR | GENERAR_PDF | LOGIN
  seccion    String?
  registroId String?  @map("registro_id")
  fecha      DateTime @default(now())

  @@index([usuarioId, fecha])
  @@map("auditoria")
}
